{
  "Urls": "http://localhost:5101;http://localhost:5102",
  "ReverseProxy": {
    "Routes": {
      "Wallet": {
        "ClusterId": "Wallet",
        "Match": {
          "Path": "{**catch-all}",
          "Hosts": [
            "localhost:5101",
            "127.0.0.1:5101"
          ]
        }
      },
      "Game": {
        "ClusterId": "Game",
        "Match": {
          "Path": "{**catch-all}",
          "Hosts": [
            "localhost:5102",
            "127.0.0.1:5102"
          ]
        }
      }
    },
    "Clusters": {
      "Wallet": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:02",
            "Timeout": "00:00:01",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "Wallet1": {
            "Address": "http://localhost:5201/"
          },
          "Wallet2": {
            "Address": "http://localhost:5301/"
          }
        }
      },
      "Game": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:02",
            "Timeout": "00:00:01",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "Game1": {
            "Address": "http://localhost:5202/"
          },
          "Game2": {
            "Address": "http://localhost:5302/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
